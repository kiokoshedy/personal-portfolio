# Copy to .env and fill in real values. Never commit .env.

# Contact API (server.js)
PORT=5000
# Gmail address that receives portfolio enquiries
CONTACT_EMAIL=shkmusembi@gmail.com
# Gmail login + App Password (https://myaccount.google.com/apppasswords)
EMAIL_USER=
EMAIL_PASS=
# Submissions allowed per IP per hour
CONTACT_RATE_LIMIT=5

# Front end (Contact.js) - leave unset to use http://localhost:5000
REACT_APP_CONTACT_API=
